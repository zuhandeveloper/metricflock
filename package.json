{
  "name": "metricflock",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "description": "Multi-website Google Analytics & Publisher Management System",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "prepare": "husky",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:status": "tsx scripts/db-manager.ts status",
    "db:reset": "tsx scripts/db-manager.ts reset",
    "build:cf": "prisma generate && opennextjs-cloudflare build",
    "preview:cf": "pnpm build:cf && opennextjs-cloudflare preview",
    "deploy:cf": "pnpm build:cf && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "worker": "tsx src/workers/index.ts"
  },
  "dependencies": {
    "@google-analytics/data": "^7.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.108.0",
    "better-auth": "1.7.26",
    "bullmq": "^6.7.7",
    "dotenv": "^18.0.10",
    "google-gax": "^6.17.0",
    "googleapis": "^190.0.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/dotenv-defaults": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "turbo": "2.11.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
