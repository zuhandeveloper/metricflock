{
  "name": "metricflock",
  "version": "0.1.0",
  "description": "Multi-website Google Analytics & Publisher Management System",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @metricflock/web dev",
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @metricflock/db db:generate",
    "db:migrate": "pnpm --filter @metricflock/db db:migrate",
    "db:reset": "pnpm --filter @metricflock/db db:reset",
    "db:seed": "pnpm --filter @metricflock/db db:seed",
    "db:status": "pnpm --filter @metricflock/db db:status",
    "db:studio": "pnpm --filter @metricflock/db db:studio",
    "deps:check": "pnpm outdated",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && bash scripts/check-boundaries.sh",
    "postinstall": "node scripts/copy-brand-assets.mjs && pnpm --filter @metricflock/db build",
    "prepare": "husky",
    "sbom": "pnpm dlx @cyclonedx/cdxgen@12.9.3 -o sbom.cdx.json .",
    "smoke": "bash scripts/smoke-test.sh",
    "start": "pnpm --filter @metricflock/web start",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "pnpm --filter @metricflock/web test:watch",
    "turbo:graph": "turbo run build --graph",
    "typecheck": "turbo run typecheck",
    "worker": "pnpm --filter @metricflock/worker start"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.4",
    "turbo": "^2.11.13"
  }
}
