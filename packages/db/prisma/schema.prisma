// Multi-website Google Analytics & Publisher Management System
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  // URL lives in prisma.config.ts (Prisma 7 no longer allows `url` here).
}

enum Role {
  SUPER_ADMIN
  TEAM_ADMIN
  TEAM_MEMBER
}
enum WebsiteStatus {
  ACTIVE
  PENDING_SETUP
  DISCONNECTED
  TRANSFER_PENDING
  SOLD
  ARCHIVED
}
enum ConnectionOwnerType {
  TEAM
  WEBSITE
}
enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  NEEDS_REAUTH
  DISCONNECTED
}
enum Provider {
  GA4
  SEARCH_CONSOLE
  ADSENSE
  AD_MANAGER
}
enum MappingStatus {
  MAPPED
  PENDING
  UNMAPPED
  ERROR
}
enum TransferStatus {
  INITIATED
  PENDING_ACCEPTANCE
  PENDING_CONNECTION
  TRANSFERRED
  COMPLETED
  CANCELLED
  FAILED
  EXPIRED
}
enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
}
enum SyncJobType {
  OAUTH_REFRESH
  PROPERTY_DISCOVERY
  GA4_REALTIME
  GA4_HISTORICAL
  SEARCH_CONSOLE
  ADSENSE
  AD_MANAGER
  CACHE_REFRESH
  HEALTH_CHECK
  SCHEDULED_REPORT
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  teams     Team[]
  websites  Website[]
  connections GoogleConnection[]
  auditLogs AuditLog[]
  invites   OrganizationInvite[]
  reportSchedule ReportSchedule?
}

model User {
  id           String   @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // better-auth required fields (email is globally unique: better-auth looks users up by email alone)
  name         String
  email        String   @unique
  emailVerified Boolean @default(false)
  image        String?
  role         Role     @default(TEAM_MEMBER)
  // better-auth two-factor plugin flag (Stage 7, AUTH-11/MFA).
  twoFactorEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  accounts     Account[]
  twoFactors   TwoFactor[]
  teamMemberships TeamMember[]
  websiteAssignments WebsiteAssignment[]
  createdConnections GoogleConnection[] @relation("ConnectionCreatedBy")
  oauthStates   OAuthState[]
  initiatedTransfers WebsiteTransfer[] @relation("TransferInitiatedBy")
  acceptedTransfers  WebsiteTransfer[] @relation("TransferAcceptedBy")
  auditLogs    AuditLog[] @relation("AuditActor")
  sentInvites  OrganizationInvite[] @relation("InviteSentBy")
  @@index([organizationId, role])
  // Composite-FK target (Phase 4, F-4.1): membership/assignment tables
  // reference (id, organizationId) so a user can never be attached to
  // another organization's team or website at the database level.
  @@unique([id, organizationId])
}

// Organization invite (invite-flow pass): an org admin invites an email
// with a role. When that email signs up (or an existing account accepts),
// the user joins THIS organization with the invite's role instead of
// getting a fresh organization. Only the SHA-256 hash of the token is
// stored; the raw token travels in the invite link.
model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(TEAM_MEMBER)
  tokenHash      String       @unique
  invitedById    String
  invitedBy      User         @relation("InviteSentBy", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  @@index([organizationId, email])
  @@index([email, acceptedAt])
}

// Phase 7.3 — scheduled email reports. One schedule per organization:
// the worker's scheduler enqueues a report job on the configured
// weekday/hour (UTC); the report is built from per-website snapshots
// (never live fan-out). Empty recipients = org SUPER_ADMINs.
model ReportSchedule {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(false)
  dayOfWeek      Int          @default(1) // 0=Sunday .. 6=Saturday (UTC)
  hourUtc        Int          @default(8)
  recipients     Json         @default("[]") // string[] of email addresses
  lastSentAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// better-auth session (replaces the old custom tokenHash session)
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

// better-auth credential / OAuth account. Passwords are scrypt hashes managed
// by better-auth — never store or compare them by hand.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  members        TeamMember[]
  websites       Website[]
  connections    GoogleConnection[]
  transfersFrom  WebsiteTransfer[] @relation("TransferFromTeam")
  transfersTo    WebsiteTransfer[] @relation("TransferToTeam")
  @@unique([organizationId, slug])
  // Composite-FK target: lets other tables enforce same-organization
  // relations at the database level (Stage 2, DB-2).
  @@unique([id, organizationId])
  @@index([organizationId])
}

model TeamMember {
  id             String   @id @default(cuid())
  // Phase 4 (F-4.1): organizationId denormalized so composite FKs can
  // enforce same-organization membership at the database level — the
  // team and the user must both belong to this organization.
  organizationId String
  teamId         String
  team           Team     @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  isAdmin        Boolean  @default(false)
  createdAt      DateTime @default(now())
  @@unique([teamId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Website {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String?
  // Composite FK: a website's team must belong to the same organization
  // (Stage 2, DB-2). Restrict: a team with websites cannot be deleted
  // until its websites are moved or deleted.
  team           Team?    @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  name           String
  domain         String
  url            String
  description    String?
  status         WebsiteStatus @default(PENDING_SETUP)
  purchaseDate   DateTime?
  saleDate       DateTime?
  purchasePrice  Decimal? @db.Decimal(12, 2)
  salePrice      Decimal? @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignments    WebsiteAssignment[]
  integrations   WebsiteIntegration[]
  connections    GoogleConnection[]
  transfers      WebsiteTransfer[]
  syncJobs       AnalyticsSyncJob[]
  health         IntegrationHealth[]
  cacheEntries   AnalyticsCache[]
  @@unique([organizationId, domain])
  // Composite-FK target (Stage 2, DB-2).
  @@unique([id, organizationId])
  @@index([organizationId, teamId, status])
}

model WebsiteAssignment {
  id             String   @id @default(cuid())
  // Phase 4 (F-4.1): same-organization composite FKs, as on TeamMember.
  organizationId String
  websiteId      String
  website        Website  @relation(fields: [websiteId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt      DateTime @default(now())
  @@unique([websiteId, userId])
  @@index([userId])
  @@index([organizationId])
}

model WebsiteTransfer {
  id            String   @id @default(cuid())
  websiteId     String
  website       Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  fromTeamId    String?
  fromTeam      Team?    @relation("TransferFromTeam", fields: [fromTeamId], references: [id], onDelete: SetNull)
  toTeamId      String
  toTeam        Team     @relation("TransferToTeam", fields: [toTeamId], references: [id], onDelete: Restrict)
  initiatedById String
  initiatedBy   User     @relation("TransferInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  // Two-sided acceptance (Stage 7, API-4/DB-4): the destination team's
  // admin accepts before anything moves; open transfers expire.
  acceptedById  String?
  acceptedBy    User?    @relation("TransferAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt    DateTime?
  expiresAt     DateTime?
  status        TransferStatus @default(INITIATED)
  reason        String?
  connectionHealthChecked Boolean @default(false)
  initiatedAt   DateTime @default(now())
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([websiteId, status])
}

model GoogleConnection {
  id                   String   @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Legacy polymorphic owner (Stage 2, DB-1): kept during the transition
  // to typed FKs below; dropped in a later release once all reads/writes
  // use teamId/websiteId. New code must always write the typed columns.
  ownerType            ConnectionOwnerType
  ownerId              String
  // Typed owner FKs (exactly one is set; enforced by a CHECK constraint
  // in the Stage 2 migration). Composite FKs also enforce that the owner
  // belongs to the same organization. Cascade: deleting a team/website
  // deletes its connections instead of orphaning encrypted tokens.
  teamId               String?
  team                 Team?    @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  websiteId            String?
  website              Website? @relation(fields: [websiteId, organizationId], references: [id, organizationId], onDelete: Cascade)
  googleAccountEmail   String
  googleAccountId      String?
  encryptedRefreshToken String
  encryptedAccessToken  String?
  tokenExpiresAt       DateTime?
  scopes               String[]
  status               ConnectionStatus @default(ACTIVE)
  createdById          String
  createdBy            User     @relation("ConnectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lastUsedAt           DateTime?
  lastSuccessfulAuthAt DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  properties           GoogleProperty[]
  searchConsoleProps   SearchConsoleProperty[]
  adsenseAccounts      AdSenseAccount[]
  adManagerNetworks    AdManagerNetwork[]
  integrations         WebsiteIntegration[]
  health               IntegrationHealth[]
  @@unique([organizationId, ownerType, ownerId, googleAccountEmail])
  @@index([organizationId, ownerType, ownerId, status])
  @@index([organizationId, teamId, status])
  @@index([organizationId, websiteId, status])
  @@index([status, tokenExpiresAt])
}

// Persisted OAuth flow state (Stage 3, OAUTH-1/2/5): one row per connect
// attempt, consumed atomically at callback so a state value can never be
// replayed. The raw nonce only travels in the `state` query parameter;
// only its SHA-256 hash is stored. codeVerifier is the PKCE verifier.
model OAuthState {
  id             String   @id @default(cuid())
  nonceHash      String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  ownerType      ConnectionOwnerType
  ownerId        String
  codeVerifier   String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime @default(now())
  @@index([expiresAt])
}

model GoogleProperty {
  id             String   @id @default(cuid())
  connectionId   String
  connection     GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  propertyId     String
  displayName    String?
  accountId      String?
  createdAt      DateTime @default(now())
  integrations   WebsiteIntegration[]
  @@unique([connectionId, propertyId])
  // Composite-FK target (Phase 4, F-4.1).
  @@unique([id, connectionId])
}

model SearchConsoleProperty {
  id           String   @id @default(cuid())
  connectionId String
  connection   GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  siteUrl      String
  permissionLevel String?
  createdAt    DateTime @default(now())
  integrations WebsiteIntegration[]
  @@unique([connectionId, siteUrl])
  // Composite-FK target (Phase 4, F-4.1).
  @@unique([id, connectionId])
}

model AdSenseAccount {
  id           String   @id @default(cuid())
  connectionId String
  connection   GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  accountId    String
  displayName  String?
  createdAt    DateTime @default(now())
  integrations WebsiteIntegration[]
  @@unique([connectionId, accountId])
  // Composite-FK target (Phase 4, F-4.1).
  @@unique([id, connectionId])
}

model AdManagerNetwork {
  id           String   @id @default(cuid())
  connectionId String
  connection   GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  networkCode  String
  displayName  String?
  createdAt    DateTime @default(now())
  integrations WebsiteIntegration[]
  @@unique([connectionId, networkCode])
  // Composite-FK target (Phase 4, F-4.1).
  @@unique([id, connectionId])
}

model WebsiteIntegration {
  id                 String   @id @default(cuid())
  websiteId          String
  website            Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  provider           Provider
  googleConnectionId String?
  googleConnection   GoogleConnection? @relation(fields: [googleConnectionId], references: [id], onDelete: SetNull)
  // Phase 4 (F-4.1): property FKs are composite with googleConnectionId —
  // a mapped property must belong to the integration's own connection,
  // enforced by the database, not only by the map route. (Postgres
  // MATCH SIMPLE: the check applies whenever both columns are set,
  // which the map route always does.)
  googlePropertyId   String?
  googleProperty     GoogleProperty? @relation(fields: [googlePropertyId, googleConnectionId], references: [id, connectionId], onDelete: SetNull)
  searchConsolePropertyId String?
  searchConsoleProperty SearchConsoleProperty? @relation(fields: [searchConsolePropertyId, googleConnectionId], references: [id, connectionId], onDelete: SetNull)
  adsenseAccountId   String?
  adsenseAccount     AdSenseAccount? @relation(fields: [adsenseAccountId, googleConnectionId], references: [id, connectionId], onDelete: SetNull)
  adManagerNetworkId String?
  adManagerNetwork   AdManagerNetwork? @relation(fields: [adManagerNetworkId, googleConnectionId], references: [id, connectionId], onDelete: SetNull)
  externalId         String
  resourceName       String?
  mappingStatus      MappingStatus @default(PENDING)
  verificationStatus String?
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@unique([websiteId, provider, externalId])
  @@index([websiteId, provider])
}

model AnalyticsCache {
  id         String   @id @default(cuid())
  cacheKey   String   @unique
  websiteId  String?
  website    Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  payload    Json
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  @@index([websiteId, expiresAt])
}

model AnalyticsSyncJob {
  id          String   @id @default(cuid())
  websiteId   String?
  website     Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  type        SyncJobType
  status      SyncJobStatus @default(PENDING)
  externalId  String?  @unique
  payload     Json?
  attempts    Int      @default(0)
  lastError   String?
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([websiteId, type, status, updatedAt])
}

model IntegrationHealth {
  id             String   @id @default(cuid())
  websiteId      String?
  website        Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  connectionId   String?
  connection     GoogleConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider       Provider
  status         String
  lastSuccessAt  DateTime?
  lastError      String?
  checkedAt      DateTime @default(now())
  @@unique([websiteId, provider])
  @@index([websiteId, provider, checkedAt])
  @@index([connectionId, provider])
}

// better-auth two-factor plugin (TOTP). `secret` and `backupCodes` are
// encrypted by better-auth with the auth secret before storage.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  @@index([userId])
  @@index([secret])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  // Restrict (Stage 7, DB-10): deleting an organization must not silently
  // destroy its audit trail — archive first, then delete.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorId        String?
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entityType     String?
  entityId       String?
  details        Json?
  ipAddress      String?
  requestId      String?
  createdAt      DateTime @default(now())
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}
