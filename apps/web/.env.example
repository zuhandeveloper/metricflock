# --- Database / Redis ---
DATABASE_URL="postgresql://analytics:analytics@localhost:5432/analytics_cms?schema=public"
REDIS_URL="redis://localhost:6379"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
# better-auth secret (preferred; falls back to SESSION_SECRET when unset).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# --- Transactional mail (email verification + password reset) ---
# Any SMTP provider works (Gmail app password, Resend, SES, ...). When unset,
# verification/reset links are logged to the server console instead of sent —
# fine for local dev, NOT for production.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MetricFlock <no-reply@example.com>"

# --- Seed (local/CI only) ---
# Required to run `pnpm db:seed` with NODE_ENV=production; sets the demo
# admin (demo@example.com) password. Never use the dev default in production.
SEED_DEMO_ADMIN_PASSWORD=""

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"

# --- Feature flags ---
GOOGLE_ANALYTICS_ENABLED=true
GOOGLE_SEARCH_CONSOLE_ENABLED=true
GOOGLE_ADSENSE_ENABLED=true
GOOGLE_AD_MANAGER_ENABLED=false

# --- Token encryption: base64 of exactly 32 random bytes ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# --- Sync intervals (minutes; targets, not guarantees of source-data availability) ---
SYNC_GA4_HISTORICAL_MINUTES=45
SYNC_SEARCH_CONSOLE_HOURS=8
SYNC_ADSENSE_HOURS=3
SYNC_AD_MANAGER_HOURS=3
