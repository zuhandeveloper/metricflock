# --- Database / Redis ---
# Local dev Postgres password for `docker compose up -d` (see
# docker-compose.yml). Must match the password in DATABASE_URL below.
POSTGRES_PASSWORD="change-me-dev-only"
DATABASE_URL="postgresql://analytics:analytics@localhost:5432/analytics_cms?schema=public"
REDIS_URL="redis://localhost:6379"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
# better-auth secret (preferred; falls back to SESSION_SECRET when unset).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# --- Proxy trust (rate-limit identity, A-SEC-05) ---
# Only trust x-real-ip / x-forwarded-for when a proxy that overwrites
# them sits in front of the app. On Vercel this is automatic (VERCEL=1
# is set by the platform itself). For self-hosting behind a proxy
# (Caddy, nginx, ...), set TRUST_PROXY=1. When unset and not on Vercel,
# proxy headers are ignored and all callers share one rate-limit bucket.
TRUST_PROXY=false

# --- Transactional mail (email verification + password reset) ---
# Any SMTP provider works (Gmail app password, Resend, SES, ...). When unset,
# emails are NOT delivered and bodies are never logged (they carry auth
# links). For local dev/CI only, EMAIL_LOG_PREVIEW=true prints the full
# message to the server console instead of sending it.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MetricFlock <no-reply@example.com>"
EMAIL_LOG_PREVIEW=false

# --- Seed (local/CI only) ---
# Required to run `pnpm db:seed` with NODE_ENV=production; sets the demo
# admin (demo@example.com) password. Never use the dev default in production.
SEED_DEMO_ADMIN_PASSWORD=""

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"

# --- Feature flags ---
GOOGLE_ANALYTICS_ENABLED=true
GOOGLE_SEARCH_CONSOLE_ENABLED=true
GOOGLE_ADSENSE_ENABLED=true
GOOGLE_AD_MANAGER_ENABLED=false

# --- Token encryption: base64 of exactly 32 random bytes ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=""
# Previous key — set ONLY during a rotation window (see
# docs/token-encryption-rotation.md). Leave empty otherwise.
GOOGLE_TOKEN_ENCRYPTION_KEY_PREVIOUS=""

# --- Sync intervals (minutes; targets, not guarantees of source-data availability) ---
SYNC_GA4_HISTORICAL_MINUTES=45
SYNC_SEARCH_CONSOLE_HOURS=8
SYNC_ADSENSE_HOURS=3
SYNC_AD_MANAGER_HOURS=3
# GA4 realtime sync cadence in seconds (default 300). Lower values burn
# Google quota fast — see packages/jobs/src/scheduler.ts (OPS-2).
SYNC_GA4_REALTIME_SECONDS=300
# Integration health-check cadence in hours (default 1).
SYNC_HEALTH_CHECK_HOURS=1

# --- Observability (Stage 8) ---
# Structured-log level: debug|info|warn|error (default info).
LOG_LEVEL=info
# Audit-log retention in days (worker prunes older rows; see
# docs/security/data-lifecycle.md). Default 365 when unset/invalid.
AUDIT_RETENTION_DAYS=365
# Worker health/metrics HTTP port (default 8080).
WORKER_HEALTH_PORT=8080
