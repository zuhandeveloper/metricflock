{
  "name": "@metricflock/web",
  "version": "0.1.0",
  "description": "MetricFlock web app — Next.js dashboards and API routes",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @metricflock/db build && next build",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@metricflock/auth": "workspace:*",
    "@metricflock/db": "workspace:*",
    "@metricflock/google": "workspace:*",
    "@metricflock/jobs": "workspace:*",
    "@metricflock/shared": "workspace:*",
    "@tanstack/react-query": "^5.108.2",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "next": "catalog:",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.11.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@metricflock/worker": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "catalog:",
    "vitest": "^5.1.1"
  }
}
