{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Minimal Cloudflare config — Phase 1 scaffolding only. The full
  // OpenNext deploy (assets, bindings, D1/queues) is not wired up yet;
  // `wrangler types` and `pnpm cf-typegen` use this to generate
  // cloudflare-env.d.ts. Do not deploy from this file alone.
  "name": "metricflock",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" }
}
